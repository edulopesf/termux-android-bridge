#!/usr/bin/env python3
"""
sms-listend — Termux webhook receiver for incoming SMS forwarded from Android.

Listens on 127.0.0.1:9000 and receives HTTP POST from the Termux Bridge Android app
when an SMS arrives on the device. Forwards the SMS data to any registered handlers
(bot notification, logging, etc.).

Usage:
    python3 termux/bin/sms-listend

Runs on boot via ~/.bashrc or Termux Boot:
    python3 ~/termux-android-bridge/termux/bin/sms-listend &
"""

import json
import signal
import sys
import threading
from http.server import HTTPServer, BaseHTTPRequestHandler
from datetime import datetime

PORT = 9000
HOST = "127.0.0.1"

# Handlers registry — add your own handlers here
# Each handler receives: (from_number: str, body: str, timestamp: int, parts: int)
_handlers = []
_lock = threading.Lock()


def register_handler(handler):
    """Register a handler to be called on each incoming SMS."""
    with _lock:
        _handlers.append(handler)


def unregister_handler(handler):
    """Remove a handler."""
    with _lock:
        if handler in _handlers:
            _handlers.remove(handler)


def _dispatch_sms(from_num: str, body: str, timestamp: int, parts: int):
    """Dispatch SMS to all registered handlers."""
    handlers = _handlers.copy()
    for handler in handlers:
        try:
            handler(from_num, body, timestamp, parts)
        except Exception as e:
            print(f"[ERROR] Handler {handler.__name__} failed: {e}", file=sys.stderr)


class SmsWebhookHandler(BaseHTTPRequestHandler):
    """HTTP request handler for incoming SMS webhooks from Android."""

    # Suppress HTTP request logging
    def log_message(self, format, *args):
        pass

    def do_POST(self):
        """Handle POST /webhook/sms."""
        if self.path != "/webhook/sms":
            self.send_error(404, "Not Found")
            return

        content_length = int(self.headers.get("Content-Length", "0"))
        if content_length == 0:
            self.send_error(400, "Empty body")
            return

        body = self.rfile.read(content_length)

        try:
            data = json.loads(body.decode("utf-8"))
        except json.JSONDecodeError as e:
            self.send_error(400, f"Invalid JSON: {e}")
            return

        # Extract fields
        from_num = data.get("from", "unknown")
        body_text = data.get("body", "")
        timestamp = data.get("timestamp", 0)
        parts = data.get("parts", 1)
        device = data.get("device", "unknown")

        if not body_text:
            self.send_error(400, "Missing 'body' field")
            return

        # Log to console
        ts_str = datetime.fromtimestamp(timestamp / 1000).strftime("%Y-%m-%d %H:%M:%S") if timestamp else "unknown"
        print(f"[SMS] from={from_num} ts={ts_str} parts={parts}")
        print(f"      body={body_text[:60]}{'...' if len(body_text) > 60 else ''}")

        # Dispatch to handlers in background thread
        thread = threading.Thread(
            target=_dispatch_sms,
            args=(from_num, body_text, timestamp, parts),
            daemon=True
        )
        thread.start()

        # Respond immediately — don't wait for handlers
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        response = json.dumps({"received": True, "from": from_num, "parts": parts})
        self.wfile.write(response.encode("utf-8"))

    def do_GET(self):
        """Health check endpoint."""
        if self.path == "/health":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            response = json.dumps({"status": "ok", "port": PORT, "service": "sms-listend"})
            self.wfile.write(response.encode("utf-8"))
        else:
            self.send_error(404, "Not Found")

    def do_HEALTH(self):
        """Alias for /health (HTTP method override in some clients)."""
        self.do_GET()


class HealthHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(json.dumps({"status": "ok", "port": PORT}).encode())


# Default handler — prints SMS to console
def _console_handler(from_num: str, body: str, timestamp: int, parts: int):
    ts_str = datetime.fromtimestamp(timestamp / 1000).strftime("%Y-%m-%d %H:%M:%S") if timestamp else "?"
    print(f"\n{'='*50}")
    print(f"  INCOMING SMS")
    print(f"{'='*50}")
    print(f"  From:    {from_num}")
    print(f"  Time:    {ts_str}")
    print(f"  Parts:   {parts}")
    print(f"  Message: {body}")
    print(f"{'='*50}\n")


# Register default console handler
register_handler(_console_handler)


def _shutdown_handler(signum, frame):
    print("\n[SHUTDOWN] sms-listend stopping...")
    sys.exit(0)


def run_server():
    """Start the webhook server."""
    signal.signal(signal.SIGINT, _shutdown_handler)
    signal.signal(signal.SIGTERM, _shutdown_handler)

    server = HTTPServer((HOST, PORT), SmsWebhookHandler)
    print(f"Webhook receiver listening on {HOST}:{PORT}")
    print(f"POST http://{HOST}:{PORT}/webhook/sms  — forward SMS from Android")
    print(f"GET  http://{HOST}:{PORT}/health        — health check")
    print(f"\nCtrl+C to stop\n")

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.shutdown()
        print("[STOPPED] sms-listend")


if __name__ == "__main__":
    run_server()